# Copie para .env e preencha. O .env NUNCA vai para o GitHub.

# porta do Inno (o AppClinic usa 8001; para rodar os dois juntos, use outra)
PORTA=8002

# chave secreta (sessões e cookies). Gere uma: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SECRET_KEY=

# o MESMO banco MySQL do AppClinic
DB_CLIENT=mysql2
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# pasta media/ do AppClinic (documentos dos pacientes)
MEDIA_ROOT=/home/usuario/apps/appclinic/media

# onde ficam as imagens e anexos enviados:
#   local  na pasta MEDIA_ROOT (padrão, como no AppClinic)
#   nuvem  no servidor cloud-storage (https://github.com/valdecirsanches/cloud-storage)
# Para passar os arquivos atuais para a nuvem: node tools/nuvem/migra-media.js
ARMAZENAMENTO=local
NUVEM_URL=https://cloud.x-star.com.br
# chave deste cliente no config/clients.json do cloud-storage
NUVEM_API_KEY=

RELEASE=2.0.17
NOME_SISTEMA=GERENCIADOR DE CLÍNICAS

# 1 = mostra o erro completo na tela (só para desenvolvimento)
DEBUG=0

# Memed (as mesmas chaves do settings.py do AppClinic: MEMED_API_KEY, MEMED_SECRET_KEY, MEMED_DATA_TOKEN)
MEMED_URL_API_BASE=https://api.memed.com.br/
MEMED_URL_SCRIPT_BASE=https://partners.memed.com.br/
MEMED_API_KEY=
MEMED_SECRET_KEY=
MEMED_DATA_TOKEN=
