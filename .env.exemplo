# Copie para .env e preencha. O .env NUNCA vai para o GitHub.

# porta do Inno (o AppClinic usa 8001; para rodar os dois juntos, use outra)
PORTA=8002

# chave secreta (sessões e cookies). Gere uma: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SECRET_KEY=

# o MESMO banco MySQL do AppClinic
DB_CLIENT=mysql2
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# pasta media/ do AppClinic, só para a migração dos arquivos antigos para a nuvem
MEDIA_ROOT=/home/usuario/apps/appclinic/media

# as imagens e anexos enviados ficam só na nuvem; o Inno não grava no disco.
# MEDIA_ROOT acima só é lida para copiar os arquivos antigos: node tools/nuvem/migra-media.js
# Teste a ligação com: node tools/nuvem/testa.js
NUVEM_URL=http://127.0.0.1:5190
# simples (a nuvem de ~/apps/nuvem: /upload e /download/:id) ou cloud-storage
NUVEM_TIPO=simples
# só para NUVEM_TIPO=cloud-storage: a chave do Inno no config/clients.json dele
NUVEM_API_KEY=

# a versão (Release) vem de versoes.json: veja tools/versao/nova.js
NOME_SISTEMA=GERENCIADOR DE CLÍNICAS

# 1 = mostra o erro completo na tela (só para desenvolvimento)
DEBUG=0

# Memed (as mesmas chaves do settings.py do AppClinic: MEMED_API_KEY, MEMED_SECRET_KEY, MEMED_DATA_TOKEN)
MEMED_URL_API_BASE=https://api.memed.com.br/
MEMED_URL_SCRIPT_BASE=https://partners.memed.com.br/
MEMED_API_KEY=
MEMED_SECRET_KEY=
MEMED_DATA_TOKEN=

# WhatsApp pelo WAHA (o mesmo para todas as clínicas; a tela da clínica não mostra mais o endereço)
WAHA_URL=
WAHA_API_KEY=

# WhatsApp pela Evolution API (alternativa ao WAHA; o super/administrador escolhe por clínica
# na tela da clínica). A instância na Evolution tem o nome do "ID da sessão" da clínica.
EVOLUTION_URL=
EVOLUTION_API_KEY=
# para onde a Evolution manda as respostas dos pacientes (padrão: este servidor + /webhook/resposta/)
EVOLUTION_WEBHOOK_URL=
